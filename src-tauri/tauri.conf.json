{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Squire",
  "version": "0.3.0",
  "identifier": "com.sirgijoe.squire",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Squire: Knick Knack Sack",
        "width": 1100,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Free, open-source inventory and collection manager",
    "longDescription": "Squire keeps track of your molds, cards, coins, dolls and anything else in your Knick Knack Sack — with photos, custom templates, and exports for WooCommerce, spreadsheets and print.",
    "license": "GPL-3.0-only",
    "publisher": "sirgijoe",
    "homepage": "https://sirgijoe.com",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
